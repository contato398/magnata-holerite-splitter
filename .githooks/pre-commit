#!/bin/bash
# Pre-commit hook para Magnata OS — Validações de segurança e conformidade
# Etapa 5: Hooks Locais de Segurança

set -e

_git_exec_path=$(git --exec-path 2>/dev/null || true)
_git_windows_root="/c/Program Files/Git"
if [[ ! -d "$_git_windows_root/usr/bin" ]]; then
  _git_windows_root=${_git_exec_path%/mingw64/libexec/git-core}
fi
if [[ -d "$_git_windows_root/usr/bin" ]]; then
  export PATH="$_git_windows_root/usr/bin:$_git_windows_root/mingw64/bin:$PATH"
fi
unset _git_exec_path _git_windows_root

BRANCH=$(git rev-parse --abbrev-ref HEAD)
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Fonte única de verdade: .magnata/patterns.sh (AUTHORIZED_BRANCHES,
# ALLOWED_PATHS, PROTECTED_FILES). Importada aqui no topo — a validação de
# branch (VALIDAÇÃO 1) já precisa dela. Evita divergência entre o hook
# local e o CI de governança da Etapa 6.
REPO_ROOT=$(git rev-parse --show-toplevel)
source "$REPO_ROOT/.magnata/patterns.sh"

echo ""
echo "================================"
echo "PRE-COMMIT VALIDATION"
echo "================================"
echo ""

# is_gate_pattern_source_file() agora vem de .magnata/patterns.sh (movida
# de dentro deste hook durante a correção do gate de segredos — precisava
# ser compartilhada com scripts/ci/validate_governance.sh também, para o
# hook local e o CI nunca divergirem sobre o que é "fonte do próprio
# padrão" vs. violação real).

# VALIDAÇÃO 1: Branch correta
echo "[1/14] Verificando branch..."
if ! is_authorized_branch "$BRANCH"; then
  echo -e "${RED}✗ BLOQUEADO: Branch incorreta${NC}"
  echo "  Branch atual: $BRANCH"
  echo "  Branches autorizadas: ${AUTHORIZED_BRANCHES[*]}"
  echo ""
  exit 1
fi
echo -e "${GREEN}✓ Branch correta: $BRANCH${NC}"

# VALIDAÇÃO 2: Nenhuma operação de merge/rebase em andamento
echo "[2/14] Verificando estado de operações Git..."
if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  echo -e "${RED}✗ BLOQUEADO: Operação pendente (merge/rebase/cherry-pick)${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem operações pendentes${NC}"

# VALIDAÇÃO 3: Arquivos sensíveis não podem ser alterados
# Nota: app.py, migrations/ e frontend/assets/brand/ NÃO estão aqui —
# são cobertos pela VALIDAÇÃO 6 via PROTECTED_FILES de .magnata/patterns.sh
# (fonte única de verdade). Esta lista cobre só o que não tem equivalente lá.
echo "[3/14] Verificando proteção de arquivos sensíveis..."
STAGED_FILES=$(git diff --cached --name-only)
SENSITIVE_FILENAMES=(
  ".env"
  "secrets.json"
  "credentials.json"
)

FOUND_PROTECTED=0
for protected in "${SENSITIVE_FILENAMES[@]}"; do
  for file in $STAGED_FILES; do
    if [[ "$file" == "$protected" ]] || [[ "$file" == "$protected"* ]]; then
      echo -e "${RED}✗ BLOQUEADO: Arquivo protegido não pode ser alterado${NC}"
      echo "  Arquivo: $file"
      echo "  Proteção: $protected não pode ser modificado na Etapa 5"
      FOUND_PROTECTED=1
    fi
  done
done
if [ $FOUND_PROTECTED -eq 1 ]; then
  exit 1
fi
echo -e "${GREEN}✓ Nenhum arquivo protegido foi alterado${NC}"

# VALIDAÇÃO 4: Detecção de segredos (excluindo .githooks/ — padrões de validação)
# Detecta VALOR literal de segredo real em linhas ADICIONADAS do índice
# staged (git diff --cached, nunca o working tree) — não apenas o nome de
# uma variável/header/propriedade sensível. Lógica em
# linha_contem_segredo_real / arquivo_staged_tem_segredo
# (.magnata/patterns.sh, fonte única de verdade, também usada por
# scripts/ci/validate_governance.sh, para hook local e CI nunca
# divergirem). Nome de arquivo sensível (.env, secrets.json,
# credentials.json) é responsabilidade da VALIDAÇÃO 3 (bloqueia o arquivo em
# si); listar o nome aqui também gerava falso positivo em documentação que só
# *menciona* esses nomes em prosa, sem conter nenhum segredo real.
echo "[4/14] Verificando presença de segredos..."
FOUND_SECRETS=0
while IFS= read -r -d '' file; do
  if is_gate_pattern_source_file "$file"; then
    continue
  fi

  # Pular arquivos não-texto (arquivo deletado não existe mais no working
  # tree — "file" não roda sobre ele, e é isso mesmo: nada a escanear).
  is_binary=0
  while IFS=$'\t' read -r added deleted _path; do
    if [[ "$added" == "-" || "$deleted" == "-" ]]; then
      is_binary=1
      break
    fi
  done < <(git diff --cached --numstat -- "$file")
  if [[ $is_binary -eq 1 ]]; then
    continue
  fi

  if arquivo_staged_tem_segredo "$file"; then
    FOUND_SECRETS=1
  fi
done < <(git diff --cached --name-only -z)

if [ $FOUND_SECRETS -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Possível segredo detectado (ver achados acima)${NC}"
  echo "  Remova o segredo antes de fazer commit"
  exit 1
fi
echo -e "${GREEN}✓ Nenhum segredo detectado${NC}"

# VALIDAÇÃO 5: Espaçamento inválido
echo "[5/14] Verificando whitespace inválido..."
if git diff --cached --check > /dev/null 2>&1; then
  echo -e "${GREEN}✓ Whitespace válido${NC}"
else
  echo -e "${RED}✗ BLOQUEADO: Whitespace inválido detectado${NC}"
  git diff --cached --check
  exit 1
fi

# VALIDAÇÃO 6: Escopo permitido (padrões estruturais)
echo "[6/14] Verificando escopo permitido..."

# .magnata/patterns.sh (ALLOWED_PATHS, PROTECTED_FILES) já foi importado
# no topo do script (necessário desde a VALIDAÇÃO 1).

SCRATCH_SCOPE_PATTERNS=(
  "^_"                                                         # scratch files
  "^test_"                                                     # test scratch
)

# Exceção nominal, exata e restrita (decisão registrada,
# fix/remetente-dp-email-intake, 2026-08-04) — só estes dois arquivos de
# teste permanentes, batidos por igualdade exata de caminho completo, não
# por prefixo. NÃO afrouxa "^test_" de forma genérica: qualquer outro
# arquivo test_*, inclusive variações com sufixo (.bak/.tmp), prefixo
# extra, maiúscula diferente ou em subdiretório, continua bloqueado.
# Reaproveitada também na VALIDAÇÃO 7, que tem seu próprio
# SCRATCH_PATTERNS local — ver nota ali. Unificar as três definições
# divergentes de "arquivo scratch" (aqui, VALIDAÇÃO 7, e
# .magnata/patterns.sh) é melhoria futura registrada, não feita agora.
ARQUIVOS_TESTE_NOMINALMENTE_AUTORIZADOS=(
  "test_apps_script_email_intake_remetentes.py"
  "test_interpretar_resposta_webhook.js"
  # Exceção exata (decisão registrada, branch
  # fix/competencia-documental-confiavel, 2026-08-11) — os dois arquivos
  # de teste da Macro 5, mesmo caminho exato usado em ALLOWED_PATHS
  # (.magnata/patterns.sh). Sem isto, ficariam bloqueados por
  # SCRATCH_SCOPE_PATTERNS/SCRATCH_PATTERNS (^test_) antes mesmo de
  # chegar à checagem de ALLOWED_PATHS.
  "test_importacao_lote.py"
  "test_importacao_lote_escrita.py"
  # Exceção exata (decisão registrada, branch claude/macro-6a-commit-recovery-k7rsly,
  # 2026-08-12) — oito arquivos de teste de Macro 6A: auditoria e esteira documental.
  # Mesmo padrão de autorização nominal que Macro 5. Sem isto, ficariam bloqueados
  # por SCRATCH_SCOPE_PATTERNS/SCRATCH_PATTERNS (^test_) antes de chegar a ALLOWED_PATHS.
  "test_competencia_fiscal.py"
  "test_fase_c_async_separar.py"
  "test_fila_envios_v2_23.py"
  "test_idempotencia_esteira.py"
  "test_idempotencia_pendencia_kit.py"
  "test_kit_admissao_identidade.py"
  "test_sanitizacao_v2_20.py"
  # Exceção nominal (2026-08-22) — remoção de CPF REAL destes 2 arquivos.
  # A trava de PII do sensor do Graphify encontrou 3 CPFs com dígito
  # verificador válido commitados no repositório; `CLAUDE.md` §6 proíbe
  # dado pessoal em commit, então a correção não é opcional.
  # ⚠️ REGISTRO EXPLÍCITO: o PR que corrige o dado é o MESMO que adiciona
  # esta exceção — ou seja, ele altera a regra que o autoriza. Está
  # declarado de propósito, para receber revisão humana em vez de passar
  # despercebido. Dois nomes exatos, não um padrão.
  "test_leitura_ponto.py"
  "test_folha_ponto_v2_21.py"
  "test_seguranca_rotas_dp_fiscal.py"
  # Exceção exata (decisão registrada, branch
  # fix/holerite-ponto-pacote-assinatura) — pacote atômico de assinatura
  # eletrônica Holerite + Folha de Ponto. Mesmo padrão de autorização
  # nominal já usado para Macro 5 e Macro 6A.
  "test_pacote_assinatura_holerite_ponto.py"
  # Exceção exata (decisão registrada, branch
  # fix/holerite-ponto-pacote-assinatura, macro de fechamento) — teste da
  # rotina de reconciliação de backlog por competência (macro §5), mesmo
  # padrão nominal.
  "test_reconciliacao_backlog_holerite_ponto.py"
  # Excecoes exatas da autorrecuperacao segura (2026-08-25). Os quatro
  # testes sao permanentes do Orquestrador; nenhum outro test_*.py e
  # liberado por prefixo.
  "test_magnata_os_orquestrador_autorrecuperacao.py"
  "test_magnata_os_orquestrador_concurrency.py"
  "test_magnata_os_orquestrador_crash_consistency.py"
  "test_magnata_os_orquestrador_fila_desistencia.py"
  # Excecao exata da persistencia duravel do Orquestrador (2026-08-25).
  # Mantem test_ bloqueado por padrao e libera somente o teste contratual
  # do adapter Postgres inerte.
  "test_magnata_os_orquestrador_postgres.py"
  # Excecao exata dos contratos puros de classificacao. Mantem test_*
  # bloqueado por padrao e libera somente este teste nominal.
  "test_magnata_os_classificacao_contratos.py"
  "test_magnata_os_classificacao_prestacao_readiness.py"
  "test_magnata_os_classificacao_inventario_prestacao.py"
  "test_airtable_inventario_prestacao.py"
  "test_classificacao_guia_dctfweb_darf.py"
  "test_prestacao_shadow_e2e.py"
  "test_prestacao_readiness_shadow_real.py"
  "test_magnata_os_classificacao_inventario_prestacao_resultados.py"
  "test_magnata_os_classificacao_vinculos_prestacao.py"
  "test_airtable_vinculos_prestacao.py"
  # Excecao exata da migracao segura do classificador documental do
  # legado (branch fix/classificador-documental-legado-seguro). Mantem
  # test_* bloqueado por padrao e libera somente este teste nominal.
  "test_classificador_documental_migracao.py"
  # Excecao exata da ponte shadow de roteamento documental (branch
  # fix/roteamento-documental-shadow). Mantem test_* bloqueado por
  # padrao e libera somente este teste nominal.
  "test_roteamento_documental_shadow.py"
  # Excecao exata da integracao shadow entre ingestao real do lote e o
  # roteamento documental (branch fix/roteamento-shadow-integracao-lote).
  # Mantem test_* bloqueado por padrao e libera somente este teste nominal.
  "test_servico_lote_roteamento_shadow.py"
)

is_arquivo_teste_nominalmente_autorizado() {
  local file="$1"
  for af in "${ARQUIVOS_TESTE_NOMINALMENTE_AUTORIZADOS[@]}"; do
    if [[ "$file" == "$af" ]]; then
      return 0
    fi
  done
  return 1
}

for file in $STAGED_FILES; do
  # Exceção documental: os 4 caminhos EXATOS da hierarquia CLAUDE.md
  # (CLAUDE_HIERARCHY, comparação de igualdade via is_claude_hierarchy_path
  # — nunca um padrão amplo) atravessam tanto PROTECTED_FILES quanto
  # ALLOWED_PATHS. Qualquer outro arquivo, inclusive outro CLAUDE.md fora
  # desta lista, ou qualquer outro arquivo nos mesmos diretórios
  # (frontend/, magnata_os/, migrations/), continua sujeito às regras
  # normais abaixo sem exceção.
  if is_claude_hierarchy_path "$file"; then
    continue
  fi

  # Verificar se está em lista de bloqueio (PROTECTED_FILES de .magnata/patterns.sh)
  BLOCKED=0
  if ! is_arquivo_teste_nominalmente_autorizado "$file"; then
    for pattern in "${PROTECTED_FILES[@]}" "${SCRATCH_SCOPE_PATTERNS[@]}"; do
      if [[ "$file" =~ $pattern ]]; then
        BLOCKED=1
        break
      fi
    done
  fi

  if [ $BLOCKED -eq 1 ]; then
    # Exceção: app.py pode ser autorizado por blob exato
    if [[ "$file" == "app.py" ]]; then
      authorization_found=0
      actual_blob=$(git hash-object --filters --path="app.py" "$file" 2>/dev/null || echo "")

      # Procurar em todos os arquivos de autorização de app.py
      if [[ -d ".magnata/app-py-authorizations" ]]; then
        for auth_file in .magnata/app-py-authorizations/*.gitblob; do
          if [[ ! -f "$auth_file" ]]; then
            continue
          fi
          while read -r expected_blob authorized_path; do
            expected_blob=${expected_blob%$'\r'}
            authorized_path=${authorized_path%$'\r'}
            [[ -z "$expected_blob" || "$expected_blob" == \#* ]] && continue
            if [[ "$authorized_path" == "app.py" && "${expected_blob,,}" == "$actual_blob" ]]; then
              authorization_found=1
              break 2
            fi
          done < "$auth_file"
        done
      fi

      if [[ $authorization_found -eq 0 ]]; then
        echo -e "${RED}✗ BLOQUEADO: Arquivo protegido não autorizado${NC}"
        echo "  Arquivo: $file"
        echo "  Blob atual: $actual_blob"
        echo "  Nenhuma autorização válida por blob exato encontrada"
        exit 1
      fi
      # A autorizaÃ§Ã£o por blob exato substitui somente a checagem nominal de
      # ALLOWED_PATHS para este app.py. As validaÃ§Ãµes anteriores (segredos,
      # whitespace e arquivos sensÃ­veis) jÃ¡ foram executadas normalmente.
      continue
    else
      echo -e "${RED}✗ BLOQUEADO: Arquivo protegido não autorizado${NC}"
      echo "  Arquivo: $file"
      exit 1
    fi
  fi

  # Verificar se está em lista de permissão (ALLOWED_PATHS de .magnata/patterns.sh)
  FOUND=0
  for pattern in "${ALLOWED_PATHS[@]}" "^\.claude/skills/" "^\.claude/agents/" "^MAGNATA_ETAPA5B_.*\.md$"; do
    if [[ "$file" =~ $pattern ]]; then
      FOUND=1
      break
    fi
  done

  if [ $FOUND -eq 0 ]; then
    echo -e "${RED}✗ BLOQUEADO: Arquivo fora do escopo permitido${NC}"
    echo "  Arquivo: $file"
    echo "  Escopo permitido: ver ALLOWED_PATHS em .magnata/patterns.sh"
    echo "  (+ .claude/skills/**, .claude/agents/**, MAGNATA_ETAPA5B_*.md)"
    exit 1
  fi
done
echo -e "${GREEN}✓ Todos os arquivos dentro do escopo permitido${NC}"

# VALIDAÇÃO 7: Sem arquivos scratch no commit
echo "[7/14] Verificando arquivos scratch..."
SCRATCH_PATTERNS=(
  "^_"
  "^test_"
  "\.tmp"
  "\.backup"
)

FOUND_SCRATCH=0
for file in $STAGED_FILES; do
  # Mesma exceção nominal da VALIDAÇÃO 6 (ver comentário lá) — reaproveitada
  # aqui porque esta validação tem seu próprio SCRATCH_PATTERNS local,
  # independente do de lá e do de .magnata/patterns.sh.
  if is_arquivo_teste_nominalmente_autorizado "$file"; then
    continue
  fi
  for pattern in "${SCRATCH_PATTERNS[@]}"; do
    if [[ "$file" =~ $pattern ]]; then
      echo -e "${YELLOW}⚠ AVISO: Arquivo de scratch detectado no commit${NC}"
      echo "  Arquivo: $file"
      FOUND_SCRATCH=1
    fi
  done
done
if [ $FOUND_SCRATCH -eq 1 ]; then
  echo -e "${YELLOW}Use: git reset <arquivo> para remover do staging${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Nenhum arquivo scratch no commit${NC}"

# VALIDAÇÃO 8: Staging não pode estar vazio
echo "[8/14] Verificando staging não vazio..."
if [ -z "$STAGED_FILES" ]; then
  echo -e "${RED}✗ BLOQUEADO: Staging vazio — nada a commitar${NC}"
  echo "  Use: git add <arquivo> antes de git commit"
  exit 1
fi
echo -e "${GREEN}✓ Staging com conteúdo${NC}"

# VALIDAÇÃO 9: Gate Documental — 11º módulo
echo "[9/14] Verificando gate documental: 11º módulo..."
GATE_SECURITY_MODULE_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if is_gate_pattern_source_file "$file"; then continue; fi
  if ! is_normative_doc "$file"; then continue; fi
  if git diff --cached "$file" | grep -E "(## 11º módulo|11º módulo.*Segurança)" > /dev/null 2>&1; then
    GATE_SECURITY_MODULE_FOUND=1
    break
  fi
done
if [ $GATE_SECURITY_MODULE_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta declarar 11º módulo${NC}"
  echo "  Arquitetura atual: Segurança e Plataforma como camadas transversais"
  exit 1
fi
echo -e "${GREEN}✓ Sem tentativa de 11º módulo separado${NC}"

# VALIDAÇÃO 10: Gate Documental — 9 camadas
echo "[10/14] Verificando gate documental: modelo de camadas..."
GATE_LAYERS_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if is_gate_pattern_source_file "$file"; then continue; fi
  if ! is_normative_doc "$file"; then continue; fi
  if git diff --cached "$file" | grep -E "(^[+].*9 camadas|^[+].*nove camadas)" > /dev/null 2>&1; then
    GATE_LAYERS_FOUND=1
    break
  fi
done
if [ $GATE_LAYERS_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta introduzir 9 camadas sequenciais${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Modelo de camadas conforme arquitetura${NC}"

# VALIDAÇÃO 11: Gate Documental — Autonomia percentual
echo "[11/14] Verificando gate documental: percentuais de autonomia..."
GATE_AUTONOMY_PCT_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if is_gate_pattern_source_file "$file"; then continue; fi
  if ! is_normative_doc "$file"; then continue; fi
  if git diff --cached "$file" | grep -iE "^[+].*autonomia.*[0-9]+\s*(%|perce?nt)" > /dev/null 2>&1; then
    GATE_AUTONOMY_PCT_FOUND=1
    break
  fi
done
if [ $GATE_AUTONOMY_PCT_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta introduzir percentuais abstratos${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem percentuais de autonomia abstratos${NC}"

# VALIDAÇÃO 12: Gate Documental — ADR silenciosa
echo "[12/14] Verificando gate documental: ADR silenciosa..."
GATE_ADR_SILENT_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if is_gate_pattern_source_file "$file"; then continue; fi
  if ! is_normative_doc "$file"; then continue; fi
  if git diff --cached "$file" | grep -iE "(Item de Ingestão foi renomeado|Documento substitui Item)" > /dev/null 2>&1; then
    GATE_ADR_SILENT_FOUND=1
    break
  fi
done
if [ $GATE_ADR_SILENT_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta introduzir resolução silenciosa da ADR${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem ADR resolvida silenciosamente${NC}"

# VALIDAÇÃO 13: Reforço de operações em progresso
echo "[13/14] Reforçando: sem operações em progresso..."
if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  echo -e "${RED}✗ BLOQUEADO: Operação de merge/rebase/cherry-pick em andamento${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Nenhuma operação em progresso${NC}"

# VALIDAÇÃO 14: Confirmação de que nenhuma validação anterior falhou
echo "[14/14] Validação consolidada..."
echo -e "${GREEN}✓ Todas as validações passaram${NC}"

echo ""
echo -e "${GREEN}================================"
echo "PRE-COMMIT: TODAS AS 14 VALIDAÇÕES APROVADAS"
echo "================================${NC}"
echo ""

exit 0
