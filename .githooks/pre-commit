#!/bin/bash
# Pre-commit hook para Magnata OS — Validações de segurança e conformidade
# Etapa 5: Hooks Locais de Segurança

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)
EXPECTED_BRANCH="feat/magnata-os-claude-powerpack"
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo ""
echo "================================"
echo "PRE-COMMIT VALIDATION"
echo "================================"
echo ""

# VALIDAÇÃO 1: Branch correta
echo "[1/7] Verificando branch..."
if [ "$BRANCH" != "$EXPECTED_BRANCH" ]; then
  echo -e "${RED}✗ BLOQUEADO: Branch incorreta${NC}"
  echo "  Branch atual: $BRANCH"
  echo "  Branch esperada: $EXPECTED_BRANCH"
  echo ""
  exit 1
fi
echo -e "${GREEN}✓ Branch correta: $BRANCH${NC}"

# VALIDAÇÃO 2: Nenhuma operação de merge/rebase em andamento
echo "[2/7] Verificando estado de operações Git..."
if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  echo -e "${RED}✗ BLOQUEADO: Operação pendente (merge/rebase/cherry-pick)${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem operações pendentes${NC}"

# VALIDAÇÃO 3: Arquivos sensíveis não podem ser alterados
echo "[3/7] Verificando proteção de arquivos sensíveis..."
STAGED_FILES=$(git diff --cached --name-only)
PROTECTED_FILES=(
  "app.py"
  "migrations/"
  "frontend/assets/brand/"
  ".env"
  "secrets.json"
  "credentials.json"
)

FOUND_PROTECTED=0
for protected in "${PROTECTED_FILES[@]}"; do
  for file in $STAGED_FILES; do
    if [[ "$file" == "$protected" ]] || [[ "$file" == "$protected"* ]]; then
      echo -e "${RED}✗ BLOQUEADO: Arquivo protegido não pode ser alterado${NC}"
      echo "  Arquivo: $file"
      echo "  Proteção: $protected não pode ser modificado na Etapa 5"
      FOUND_PROTECTED=1
    fi
  done
done
if [ $FOUND_PROTECTED -eq 1 ]; then
  exit 1
fi
echo -e "${GREEN}✓ Nenhum arquivo protegido foi alterado${NC}"

# VALIDAÇÃO 4: Detecção de segredos
echo "[4/7] Verificando presença de segredos..."
SECRETS_PATTERNS=(
  "BEGIN RSA PRIVATE KEY"
  "BEGIN PRIVATE KEY"
  "BEGIN OPENSSH PRIVATE KEY"
  "api[_-]?key"
  "secret[_-]?key"
  "aws[_-]?access[_-]?key"
  "aws[_-]?secret[_-]?access[_-]?key"
  "github[_-]?token"
  "GITHUB_TOKEN"
  "GH_TOKEN"
  "Authorization: Bearer"
  "password.*="
  "passwd.*="
  "^\.env"
  "credentials\.json"
)

FOUND_SECRETS=0
for file in $STAGED_FILES; do
  # Pular arquivos não-texto
  if file "$file" | grep -q "binary"; then
    continue
  fi

  for pattern in "${SECRETS_PATTERNS[@]}"; do
    if git diff --cached "$file" | grep -iE "$pattern" > /dev/null 2>&1; then
      echo -e "${RED}✗ BLOQUEADO: Possível segredo detectado${NC}"
      echo "  Arquivo: $file"
      echo "  Padrão: $pattern"
      echo "  Remova o segredo antes de fazer commit"
      FOUND_SECRETS=1
    fi
  done
done
if [ $FOUND_SECRETS -eq 1 ]; then
  exit 1
fi
echo -e "${GREEN}✓ Nenhum segredo detectado${NC}"

# VALIDAÇÃO 5: Espaçamento inválido
echo "[5/7] Verificando whitespace inválido..."
if git diff --cached --check > /dev/null 2>&1; then
  echo -e "${GREEN}✓ Whitespace válido${NC}"
else
  echo -e "${RED}✗ BLOQUEADO: Whitespace inválido detectado${NC}"
  git diff --cached --check
  exit 1
fi

# VALIDAÇÃO 6: Escopo permitido (somente Etapa 5)
echo "[6/7] Verificando escopo permitido..."
ALLOWED_PATTERNS=(
  "\.git/hooks/"
  "\.claude/"
  "docs/magnata-os/"
  "MAGNATA_AI_ENGINEERING_POWERPACK_ETAPA5.md"
)

ALLOWED=0
for file in $STAGED_FILES; do
  # Pular arquivos que podem estar sendo removidos
  if [ ! -f "$file" ] && [ ! -d "$file" ]; then
    continue
  fi

  FOUND=0
  for pattern in "${ALLOWED_PATTERNS[@]}"; do
    if [[ "$file" == "$pattern"* ]]; then
      FOUND=1
      break
    fi
  done

  if [ $FOUND -eq 0 ]; then
    echo -e "${RED}✗ BLOQUEADO: Arquivo fora do escopo da Etapa 5${NC}"
    echo "  Arquivo: $file"
    echo "  Escopo permitido: hooks, docs, CLAUDE.md, README"
    exit 1
  fi
done
echo -e "${GREEN}✓ Todos os arquivos dentro do escopo permitido${NC}"

# VALIDAÇÃO 7: Sem arquivos scratch no commit
echo "[7/7] Verificando arquivos scratch..."
SCRATCH_PATTERNS=(
  "^_"
  "^test_"
  "\.tmp"
  "\.backup"
)

FOUND_SCRATCH=0
for file in $STAGED_FILES; do
  for pattern in "${SCRATCH_PATTERNS[@]}"; do
    if [[ "$file" =~ $pattern ]]; then
      echo -e "${YELLOW}⚠ AVISO: Arquivo de scratch detectado no commit${NC}"
      echo "  Arquivo: $file"
      FOUND_SCRATCH=1
    fi
  done
done
if [ $FOUND_SCRATCH -eq 1 ]; then
  echo -e "${YELLOW}Use: git reset <arquivo> para remover do staging${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Nenhum arquivo scratch no commit${NC}"

echo ""
echo -e "${GREEN}================================"
echo "PRE-COMMIT: TODAS AS VALIDAÇÕES APROVADAS"
echo "================================${NC}"
echo ""

exit 0
