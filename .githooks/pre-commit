#!/bin/bash
# Pre-commit hook para Magnata OS — Validações de segurança e conformidade
# Etapa 5: Hooks Locais de Segurança

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)
EXPECTED_BRANCH="feat/magnata-os-claude-powerpack"
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo ""
echo "================================"
echo "PRE-COMMIT VALIDATION"
echo "================================"
echo ""

# VALIDAÇÃO 1: Branch correta
echo "[1/14] Verificando branch..."
if [ "$BRANCH" != "$EXPECTED_BRANCH" ]; then
  echo -e "${RED}✗ BLOQUEADO: Branch incorreta${NC}"
  echo "  Branch atual: $BRANCH"
  echo "  Branch esperada: $EXPECTED_BRANCH"
  echo ""
  exit 1
fi
echo -e "${GREEN}✓ Branch correta: $BRANCH${NC}"

# VALIDAÇÃO 2: Nenhuma operação de merge/rebase em andamento
echo "[2/14] Verificando estado de operações Git..."
if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  echo -e "${RED}✗ BLOQUEADO: Operação pendente (merge/rebase/cherry-pick)${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem operações pendentes${NC}"

# VALIDAÇÃO 3: Arquivos sensíveis não podem ser alterados
echo "[3/14] Verificando proteção de arquivos sensíveis..."
STAGED_FILES=$(git diff --cached --name-only)
PROTECTED_FILES=(
  "app.py"
  "migrations/"
  "frontend/assets/brand/"
  ".env"
  "secrets.json"
  "credentials.json"
)

FOUND_PROTECTED=0
for protected in "${PROTECTED_FILES[@]}"; do
  for file in $STAGED_FILES; do
    if [[ "$file" == "$protected" ]] || [[ "$file" == "$protected"* ]]; then
      echo -e "${RED}✗ BLOQUEADO: Arquivo protegido não pode ser alterado${NC}"
      echo "  Arquivo: $file"
      echo "  Proteção: $protected não pode ser modificado na Etapa 5"
      FOUND_PROTECTED=1
    fi
  done
done
if [ $FOUND_PROTECTED -eq 1 ]; then
  exit 1
fi
echo -e "${GREEN}✓ Nenhum arquivo protegido foi alterado${NC}"

# VALIDAÇÃO 4: Detecção de segredos (excluindo .githooks/ — padrões de validação)
echo "[4/14] Verificando presença de segredos..."
SECRETS_PATTERNS=(
  "BEGIN RSA PRIVATE KEY"
  "BEGIN PRIVATE KEY"
  "BEGIN OPENSSH PRIVATE KEY"
  "api[_-]?key"
  "secret[_-]?key"
  "aws[_-]?access[_-]?key"
  "aws[_-]?secret[_-]?access[_-]?key"
  "github[_-]?token"
  "GITHUB_TOKEN"
  "GH_TOKEN"
  "Authorization: Bearer"
  "password.*="
  "passwd.*="
  "^\.env"
  "credentials\.json"
)

FOUND_SECRETS=0
for file in $STAGED_FILES; do
  # Pular arquivos .githooks/ (padrões de validação, não segredos)
  if [[ "$file" == .githooks/* ]]; then
    continue
  fi

  # Pular arquivos não-texto
  if file "$file" | grep -q "binary"; then
    continue
  fi

  for pattern in "${SECRETS_PATTERNS[@]}"; do
    if git diff --cached "$file" | grep -iE "$pattern" > /dev/null 2>&1; then
      echo -e "${RED}✗ BLOQUEADO: Possível segredo detectado${NC}"
      echo "  Arquivo: $file"
      echo "  Padrão: $pattern"
      echo "  Remova o segredo antes de fazer commit"
      FOUND_SECRETS=1
    fi
  done
done
if [ $FOUND_SECRETS -eq 1 ]; then
  exit 1
fi
echo -e "${GREEN}✓ Nenhum segredo detectado${NC}"

# VALIDAÇÃO 5: Espaçamento inválido
echo "[5/14] Verificando whitespace inválido..."
if git diff --cached --check > /dev/null 2>&1; then
  echo -e "${GREEN}✓ Whitespace válido${NC}"
else
  echo -e "${RED}✗ BLOQUEADO: Whitespace inválido detectado${NC}"
  git diff --cached --check
  exit 1
fi

# VALIDAÇÃO 6: Escopo permitido (lista explícita e auditável)
echo "[6/14] Verificando escopo permitido..."
ALLOWED_FILES=(
  ".githooks/README.md"
  ".githooks/commit-msg"
  ".githooks/install-hooks.sh"
  ".githooks/post-commit"
  ".githooks/pre-commit"
  ".githooks/pre-push"
  ".githooks/test-hooks.sh"
  "MAGNATA_AI_ENGINEERING_POWERPACK_ETAPA5.md"
  "MAGNATA_AI_ENGINEERING_POWERPACK_ETAPA5_PARECERES.md"
  "MAGNATA_ETAPA5B_VALIDACAO_MANUAL.md"
  "docs/magnata-os/MAGNATA_AI_HOOKS_LOCAIS.md"
  "docs/magnata-os/README.md"
)

ALLOWED=0
for file in $STAGED_FILES; do
  FOUND=0
  for allowed_file in "${ALLOWED_FILES[@]}"; do
    if [ "$file" = "$allowed_file" ]; then
      FOUND=1
      break
    fi
  done

  if [ $FOUND -eq 0 ]; then
    echo -e "${RED}✗ BLOQUEADO: Arquivo fora do escopo da Etapa 5${NC}"
    echo "  Arquivo: $file"
    echo "  Escopo permitido (lista explícita):"
    echo "    - .githooks/README.md"
    echo "    - .githooks/commit-msg"
    echo "    - .githooks/post-commit"
    echo "    - .githooks/pre-commit"
    echo "    - .githooks/pre-push"
    echo "    - .githooks/test-hooks.sh"
    echo "    - MAGNATA_AI_ENGINEERING_POWERPACK_ETAPA5.md"
    echo "    - MAGNATA_AI_ENGINEERING_POWERPACK_ETAPA5_PARECERES.md"
    echo "    - MAGNATA_ETAPA5B_VALIDACAO_MANUAL.md"
    echo "    - docs/magnata-os/MAGNATA_AI_HOOKS_LOCAIS.md"
    echo "    - docs/magnata-os/README.md"
    exit 1
  fi
done
echo -e "${GREEN}✓ Todos os arquivos dentro do escopo permitido${NC}"

# VALIDAÇÃO 7: Sem arquivos scratch no commit
echo "[7/14] Verificando arquivos scratch..."
SCRATCH_PATTERNS=(
  "^_"
  "^test_"
  "\.tmp"
  "\.backup"
)

FOUND_SCRATCH=0
for file in $STAGED_FILES; do
  for pattern in "${SCRATCH_PATTERNS[@]}"; do
    if [[ "$file" =~ $pattern ]]; then
      echo -e "${YELLOW}⚠ AVISO: Arquivo de scratch detectado no commit${NC}"
      echo "  Arquivo: $file"
      FOUND_SCRATCH=1
    fi
  done
done
if [ $FOUND_SCRATCH -eq 1 ]; then
  echo -e "${YELLOW}Use: git reset <arquivo> para remover do staging${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Nenhum arquivo scratch no commit${NC}"

# VALIDAÇÃO 8: Staging não pode estar vazio
echo "[8/14] Verificando staging não vazio..."
if [ -z "$STAGED_FILES" ]; then
  echo -e "${RED}✗ BLOQUEADO: Staging vazio — nada a commitar${NC}"
  echo "  Use: git add <arquivo> antes de git commit"
  exit 1
fi
echo -e "${GREEN}✓ Staging com conteúdo${NC}"

# VALIDAÇÃO 9: Gate Documental — 11º módulo
echo "[9/14] Verificando gate documental: 11º módulo..."
GATE_SECURITY_MODULE_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if git diff --cached "$file" | grep -E "(## 11º módulo|11º módulo.*Segurança)" > /dev/null 2>&1; then
    GATE_SECURITY_MODULE_FOUND=1
    break
  fi
done
if [ $GATE_SECURITY_MODULE_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta declarar 11º módulo${NC}"
  echo "  Arquitetura atual: Segurança e Plataforma como camadas transversais"
  exit 1
fi
echo -e "${GREEN}✓ Sem tentativa de 11º módulo separado${NC}"

# VALIDAÇÃO 10: Gate Documental — 9 camadas
echo "[10/14] Verificando gate documental: modelo de camadas..."
GATE_LAYERS_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if git diff --cached "$file" | grep -E "(^[+].*9 camadas|^[+].*nove camadas)" > /dev/null 2>&1; then
    GATE_LAYERS_FOUND=1
    break
  fi
done
if [ $GATE_LAYERS_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta introduzir 9 camadas sequenciais${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Modelo de camadas conforme arquitetura${NC}"

# VALIDAÇÃO 11: Gate Documental — Autonomia percentual
echo "[11/14] Verificando gate documental: percentuais de autonomia..."
GATE_AUTONOMY_PCT_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if git diff --cached "$file" | grep -iE "^[+].*autonomia.*[0-9]+\s*(%|perce?nt)" > /dev/null 2>&1; then
    GATE_AUTONOMY_PCT_FOUND=1
    break
  fi
done
if [ $GATE_AUTONOMY_PCT_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta introduzir percentuais abstratos${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem percentuais de autonomia abstratos${NC}"

# VALIDAÇÃO 12: Gate Documental — ADR silenciosa
echo "[12/14] Verificando gate documental: ADR silenciosa..."
GATE_ADR_SILENT_FOUND=0
for file in $STAGED_FILES; do
  if [ ! -f "$file" ]; then continue; fi
  if git diff --cached "$file" | grep -iE "(Item de Ingestão foi renomeado|Documento substitui Item)" > /dev/null 2>&1; then
    GATE_ADR_SILENT_FOUND=1
    break
  fi
done
if [ $GATE_ADR_SILENT_FOUND -eq 1 ]; then
  echo -e "${RED}✗ BLOQUEADO: Arquivo tenta introduzir resolução silenciosa da ADR${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Sem ADR resolvida silenciosamente${NC}"

# VALIDAÇÃO 13: Reforço de operações em progresso
echo "[13/14] Reforçando: sem operações em progresso..."
if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  echo -e "${RED}✗ BLOQUEADO: Operação de merge/rebase/cherry-pick em andamento${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Nenhuma operação em progresso${NC}"

# VALIDAÇÃO 14: Validação consolidada de escopo
echo "[14/14] Validação consolidada de escopo..."
for file in $STAGED_FILES; do
  FOUND=0
  for allowed_file in "${ALLOWED_FILES[@]}"; do
    if [ "$file" = "$allowed_file" ]; then
      FOUND=1
      break
    fi
  done
  if [ $FOUND -eq 0 ]; then
    echo -e "${RED}✗ BLOQUEADO: Arquivo não autorizado: $file${NC}"
    exit 1
  fi
done
echo -e "${GREEN}✓ Validação consolidada aprovada${NC}"

echo ""
echo -e "${GREEN}================================"
echo "PRE-COMMIT: TODAS AS 14 VALIDAÇÕES APROVADAS"
echo "================================${NC}"
echo ""

exit 0
