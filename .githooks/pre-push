#!/bin/bash
# Pre-push hook para Magnata OS — Autorização temporária de push
# Etapa 5: Hooks Locais de Segurança
# Este hook BLOQUEIA push por padrão, mas permite autorização por variável de ambiente

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo ""
echo "================================"
echo "PRE-PUSH VALIDATION"
echo "================================"
echo ""

# Verificar se autorização temporária foi concedida
if [ "$MAGNATA_AUTHORIZED_PUSH" = "1" ]; then
  echo -e "${GREEN}✓ AUTORIZADO: Push permitido por MAGNATA_AUTHORIZED_PUSH=1${NC}"
  echo "  Autorização válida somente para este processo"
  echo "  Variável será descartada ao fim do comando"
  echo ""
  exit 0
fi

# BLOQUEIO PADRÃO: Push não é permitido sem autorização explícita
echo -e "${RED}✗ BLOQUEADO: Push não autorizado na Etapa 5${NC}"
echo ""
echo "Mecanismo de autorização:"
echo "  MAGNATA_AUTHORIZED_PUSH=1 git push origin feat/magnata-os-claude-powerpack"
echo ""
echo "Nota:"
echo "  - Autorização é válida somente para o processo atual"
echo "  - Não persiste em .git/config"
echo "  - Deve ser reenviada a cada push"
echo "  - Use somente após aprovação dos 5 subagentes"
echo ""

exit 1
